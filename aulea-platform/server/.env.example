# Copy to .env for local development. Matches server/docker-compose.yml's postgres service.
DATABASE_URL=postgres://aulea_platform:aulea_platform@localhost:5432/aulea_platform

# SIGNUP-EXPEDITE-001: gates POST /api/signup/expedite. Set to "true" to
# enable the expedite sign-up path for manual testing; unset/anything else
# keeps it off (GET /api/config reflects this, and the endpoint itself
# still returns 403 even if a client bypasses the config check).
EXPEDITE_SIGNUP_ENABLED=true

# SIGN-UP-001: local SMTP mock (Mailpit, started by docker-compose.yml).
# View captured confirmation emails at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025

# SIGN-UP-001: used to build the confirmation link in the email
# (`{APP_BASE_URL}/api/confirm?token=...`). Not derived from request
# headers — decided during sprint planning (2026-08-21).
APP_BASE_URL=http://localhost:3000

# AUTH-UX-001 / ADR-0005: signs the session-id cookie for `express-session`
# (store: connect-pg-simple, same Postgres database as DATABASE_URL above).
# Use a long random value in any real deployment — this placeholder is for
# local dev only.
SESSION_SECRET=change-me-in-a-real-deployment
