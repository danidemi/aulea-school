{
  "name": "aulea-platform-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "postbuild": "tsx scripts/write-version.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "build:qti-fixture": "tsx scripts/build-qti-package-fixture.ts"
  },
  "dependencies": {
    "@longsightgroup/qti3-core": "0.10.5",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.0",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/adm-zip": "^0.5.8",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
