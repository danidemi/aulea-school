<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd" identifier="item-03" title="Entrare in una cartella" adaptive="false" time-dependent="false" xml:lang="it">
  <!-- node_ref: BSL-SHELL
       item: curriculum session 1, sequence 1
       type: knowledge check (scored)
       provenance: invented framing — scenario (cartella "progetti") inventato per applicare cd; BSL-SHELL dice solo "navigare il filesystem" -->
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>choice-b</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-item-body>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" max-choices="1">
      <qti-prompt>Ti trovi nella cartella <code>Documenti</code>. Dentro c'è una cartella chiamata <code>progetti</code>. Quale comando ti porta dentro <code>progetti</code>?</qti-prompt>
      <qti-simple-choice identifier="choice-a">ls progetti</qti-simple-choice>
      <qti-simple-choice identifier="choice-b">cd progetti</qti-simple-choice>
      <qti-simple-choice identifier="choice-c">progetti cd</qti-simple-choice>
      <qti-simple-choice identifier="choice-d">apri progetti</qti-simple-choice>
      <qti-simple-choice identifier="choice-dk" fixed="true">Non lo so</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct"/>
</qti-assessment-item>
